{
  "name": "theblindboxcompany-demo",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ci": "PLAYWRIGHT_BROWSER=chromium playwright test",
    "e2e:dist": "PLAYWRIGHT_BROWSER=chromium PLAYWRIGHT_EXISTING_DIST=1 playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:test": "node scripts/check-secrets.selftest.mjs",
    "audit:release": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=high",
    "verify": "npm run secrets:test && npm run secrets:check && npm run audit:release && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:all": "npm run verify && npm run e2e"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
